<div class="tasks-panel">
  {{> "modules/wfrp4e-underworld/templates/parts/timed-missions.hbs"}}
  <p class="notes">
    {{{underworldT "TasksTab.Intro"}}}
    {{underworldT "TasksTab.Available"}}: <strong>{{availableOutlaws.length}}</strong>.
  </p>

  <!-- ═══════ TEREN I PRZYGOTOWANIE ═══════ -->
  <div class="uw-prep-strip">
    <span class="uw-terrain-chip"><i class="{{terrain.icon}}"></i> {{underworldT "Camp.Terrain"}}: <strong>{{terrain.name}}</strong></span>
    {{#each activeTokens}}
      <span class="uw-token-chip" data-tooltip="{{this.desc}}"><i class="{{this.icon}}"></i> {{this.name}} <small>({{this.left}})</small></span>
    {{else}}
      <span class="uw-token-chip is-empty"><i class="fas fa-chess-pawn"></i> {{underworldT "LootTab.NoTokens"}}</span>
    {{/each}}
    {{#if gang.racket}}<span class="uw-token-chip is-racket"><i class="fas fa-store"></i> {{underworldT "Badges.racket"}}: {{gang.racket.district}}</span>{{/if}}
    {{#if lootCount}}<span class="uw-token-chip is-loot"><i class="fas fa-sack-xmark"></i> {{underworldT "Tabs.Loot"}}: {{lootCount}}{{#if hotLootCount}} ({{underworldT "TasksTab.HotCount" count=hotLootCount}}){{/if}}</span>{{/if}}
  </div>

  <!-- ═══════ SEKCJA SPECJALNA: ŚWITA HERSZTA ═══════ -->
  <div class="retinue-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
      <h3 style="margin-bottom: 0;">
        <i class="fas fa-user-shield"></i> {{underworldT "Chat.Footer"}} <small>({{underworldT "TasksTab.Escort"}}: <strong>{{retinueCount}}/{{maxRetinue}}</strong>)</small>
      </h3>
      <div class="retinue-heading-tools">
        <span class="badge-mission retinue">
          <i class="fas fa-bolt"></i> {{underworldT "TasksTab.UnlocksTactics"}}
        </span>
        <button type="button" class="btn-toggle-retinue" data-action="toggle-retinue-section" aria-expanded="true" title="{{underworldT 'Retinue.Collapse'}}">
          <i class="fas fa-chevron-up"></i> <span>{{underworldT "Collapse"}}</span>
        </button>
      </div>
    </div>
    <p class="notes" style="margin-top: 0;">
      {{{underworldT "TasksTab.RetinueHint"}}}
    </p>

    <div class="retinue-grid" style="display: flex; flex-direction: column; gap: 4px;">
      {{#each gang.roster}}
        <div class="retinue-row {{#if (bajeryEq this.assignment 'retinue')}}is-retinue{{/if}}" 
             style="display: flex; align-items: center; justify-content: space-between; border-radius: 3px;">
          <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1;">
            <img src="{{this.img}}" style="width: 26px; height: 26px; object-fit: cover; border-radius: 3px; border: 1px solid #7c5838;" />
            <strong>{{this.name}}</strong>
            {{{underworldRoleBadge this.role}}}
            {{{underworldAssignmentBadge this.assignment this.status}}}
          </div>
          <div style="flex-shrink: 0; margin-left: 8px;">
            <label style="font-size: 0.82rem; cursor: pointer; font-weight: bold; color: {{#if (bajeryEq this.assignment 'retinue')}}#8a6422{{else}}#554433{{/if}}; display: flex; align-items: center; gap: 5px;">
              <input type="checkbox" class="retinue-checkbox" data-npc-id="{{this.id}}"
                     {{#if (bajeryEq this.assignment "retinue")}}checked{{/if}}
                     {{#if (bajeryEq this.status "dead")}}disabled{{/if}}
                     {{#if (bajeryEq this.status "wounded")}}disabled{{/if}}
                     {{#if (bajeryEq this.status "arrested")}}disabled{{/if}} />
              {{#if (bajeryEq this.assignment "retinue")}}{{underworldT "TasksTab.InRetinue"}}{{else}}{{underworldT "TasksTab.Join"}}{{/if}}
            </label>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <!-- ═══════ ZLECENIA (zależne od terenu) ═══════ -->
  {{#each missionCategories}}
  <div class="mission-category {{#if this.collapsed}}collapsed{{/if}}" data-category="{{this.cssKey}}">
    <div class="category-header" data-action="toggle-category">
      <span><i class="{{this.icon}}"></i> {{this.name}} <small>({{this.hint}})</small></span>
      <i class="fas fa-chevron-down category-chevron"></i>
    </div>
    <div class="category-body">
      <div class="missions-list">
        {{#each this.missions}}
        <div class="mission-row">
          <div class="mission-row-icon {{../iconClass}}"><i class="{{this.icon}}"></i></div>
          <div class="mission-row-body">
            <strong>{{this.name}}</strong>{{#if this.tiered}} <span class="uw-tier-flag" data-tooltip="{{underworldT 'TasksTab.TierHint'}}"><i class="fas fa-layer-group"></i> {{underworldT "TasksTab.Tier"}}</span>{{/if}}
            <span class="mission-desc">{{this.desc}}</span>
            {{{underworldMissionMeta this.id this.duration}}}
          </div>
          <button type="button" class="btn-send-mission" data-action="send-mission" data-type="{{this.id}}" title="{{this.name}}">
            <i class="fas fa-paper-plane"></i> {{#if this.noNpc}}{{underworldT "Mission.Send"}}{{else}}{{underworldT "TasksTab.Assign"}}{{/if}}
          </button>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
  {{/each}}

  <!-- ═══════ WARTY OBOZOWE ═══════ -->
  <div class="guards-section" style="margin-top: 12px; border-top: 2px solid #5a3d28; padding-top: 8px;">
    <h3 style="margin: 0 0 6px 0;"><i class="fas fa-shield-alt"></i> {{underworldT "TasksTab.Watch"}}</h3>
    <p class="notes">
      {{underworldT "TasksTab.WatchHint"}}
    </p>
    <div class="guards-list" style="background: rgba(255,255,255,0.7); border: 1px solid #9e856f; border-radius: 4px; padding: 6px 10px;">
      {{#each gang.roster}}
        <div class="guard-item" style="display: flex; align-items: center; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed #c0b0a0;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <img src="{{this.img}}" style="width: 26px; height: 26px; object-fit: cover; border-radius: 3px; border: 1px solid #7c5838;" />
            <strong style="font-size: 0.88rem; color: #2b1f15;">{{this.name}}</strong>
            {{{underworldAssignmentBadge this.assignment this.status}}}
          </div>
          <label style="font-size: 0.85rem; cursor: pointer; font-weight: bold; color: #4a3828; display: flex; align-items: center; gap: 4px;">
            <input type="checkbox" class="guard-checkbox" data-npc-id="{{this.id}}"
                   {{#if (bajeryEq this.assignment "guard")}}checked{{/if}}
                   {{#if (bajeryEq this.status "dead")}}disabled{{/if}}
                   {{#if (bajeryEq this.status "wounded")}}disabled{{/if}}
                   {{#if (bajeryEq this.status "busy")}}disabled{{/if}} />
            {{underworldT "Badges.guard"}}
          </label>
        </div>
      {{/each}}
    </div>
  </div>
</div>
