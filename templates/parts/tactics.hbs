            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.distract.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Zasłona Dymna (Prowokator) -->
      <div data-order-id="smoke" class="tactic-card {{#if tacticalOrders.smoke.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.smoke.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-smog"></i> {{tacticalOrders.smoke.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.smoke.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.smoke.effect}}
        </div>
        {{#if tacticalOrders.smoke.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.smoke.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.smoke.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="smoke">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.smoke.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Piasek w Oczy (Prowokator) -->
      <div data-order-id="sand" class="tactic-card {{#if tacticalOrders.sand.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.sand.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-eye-slash"></i> {{tacticalOrders.sand.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.sand.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.sand.effect}}
        </div>
        {{#if tacticalOrders.sand.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.sand.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.sand.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="sand">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.sand.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Okrzyk Bojowy (Herszt / Prawa Ręka) -->
      <div data-order-id="rally" class="tactic-card tactic-unlocked tactic-has-retinue">
        <div class="tactic-card-header">
          <strong><i class="fas fa-fist-raised"></i> {{tacticalOrders.rally.name}}</strong>
          <span class="tactic-cost free"><i class="fas fa-dice"></i> {{localize "UNDERWORLD.TacticsTab.LeadershipAction"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.rally.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.rally.effect}}
        </div>
        <div class="tactic-executor-bar">
          <i class="fas fa-star" style="color: #f5d696;"></i> 
          {{#if tacticalOrders.rally.executor}}
            {{localize "UNDERWORLD.TacticsTab.Assists"}}: <strong>{{tacticalOrders.rally.executor.name}}</strong> ({{localize "UNDERWORLD.Ranks.lieutenant.Name"}})
          {{else}}
            {{localize "UNDERWORLD.TacticsTab.PersonalAlways"}}
          {{/if}}
        </div>
        <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="rally">
          <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
        </button>
      </div>

      <!-- Koordynacja Szyku (Prawa Ręka) -->
      <div data-order-id="coordinate" class="tactic-card {{#if tacticalOrders.coordinate.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.coordinate.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-users-cog"></i> {{tacticalOrders.coordinate.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.coordinate.desc}}</p>
        <div class="tactic-effect-summary">
