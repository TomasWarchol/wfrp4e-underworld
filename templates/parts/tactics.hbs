            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.kidneystrike.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.kidneystrike.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="kidneystrike">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.kidneystrike.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Podcięcie z Nóg (Ochroniarz) -->
      <div data-order-id="trip" class="tactic-card {{#if tacticalOrders.trip.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.trip.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-person-falling"></i> {{tacticalOrders.trip.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.trip.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.trip.effect}}
        </div>
        {{#if tacticalOrders.trip.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.trip.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.trip.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="trip">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.trip.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Taran i Przełom (Ochroniarz) -->
      <div data-order-id="bullrush" class="tactic-card {{#if tacticalOrders.bullrush.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.bullrush.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-shield-alt"></i> {{tacticalOrders.bullrush.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.bullrush.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.bullrush.effect}}
        </div>
        {{#if tacticalOrders.bullrush.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.bullrush.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.bullrush.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="bullrush">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.bullrush.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Ostrzał Nękający (Strzelec) -->
      <div data-order-id="cover" class="tactic-card {{#if tacticalOrders.cover.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.cover.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-bullseye"></i> {{tacticalOrders.cover.name}}</strong>
          <span class="tactic-cost free"><i class="fas fa-dice"></i> {{localize "UNDERWORLD.Orders.Dialog.Leadership"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.cover.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.cover.effect}}
        </div>
        {{#if tacticalOrders.cover.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.cover.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.cover.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="cover">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.cover.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Strzał Rozbrajający (Strzelec) -->
      <div data-order-id="disarm" class="tactic-card {{#if tacticalOrders.disarm.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.disarm.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-hand-holding-box"></i> {{tacticalOrders.disarm.name}}</strong>
          <span class="tactic-cost advantage-high"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost2"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.disarm.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.disarm.effect}}
        </div>
        {{#if tacticalOrders.disarm.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.disarm.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.disarm.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="disarm">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.disarm.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

    </div>
  </div>

  <!-- ═══════ SEKCJA 2: KONTROLA WALKI I DYWERSJA ═══════ -->
  <div class="tactic-group">
    <h4 class="tactic-group-title"><i class="fas fa-theater-masks"></i> {{localize "UNDERWORLD.TacticsTab.Control"}}</h4>
    <div class="tactic-cards-grid">

      <!-- Zmyłka / Kradzież Przewagi (Prowokator) -->
      <div data-order-id="distract" class="tactic-card {{#if tacticalOrders.distract.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.distract.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-mask"></i> {{tacticalOrders.distract.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.distract.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.distract.effect}}
        </div>
        {{#if tacticalOrders.distract.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.distract.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.distract.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="distract">
