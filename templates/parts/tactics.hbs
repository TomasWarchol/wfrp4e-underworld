<div class="tactics-panel flexcol">
  
  <!-- ═══════ BANER ŚWITY BOJOWEJ HERSZTA ═══════ -->
  <div class="tactics-header-banner">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
      <h3 style="margin-bottom: 0;">
        <i class="fas fa-chess-knight"></i> {{localize "UNDERWORLD.TacticsTab.Title"}}
      </h3>
      <div class="tactics-view-controls">
        <button type="button" class="btn-filter-retinue-tactics" data-action="toggle-retinue-tactics" aria-pressed="false" title="{{localize 'UNDERWORLD.Tactics.ShowActiveHint'}}">
          <i class="fas fa-user-check"></i> {{localize "UNDERWORLD.Tactics.ActiveOnly"}}
        </button>
        <button type="button" class="btn-toggle-tactics" data-action="toggle-all-tactics" aria-expanded="true" title="{{localize 'UNDERWORLD.Tactics.CollapseAllHint'}}">
          <i class="fas fa-compress-alt"></i> {{localize "UNDERWORLD.Tactics.CollapseAll"}}
        </button>
      </div>
      <span style="font-size: 0.8rem; background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 10px; border: 1px solid #9e856f;">
        {{localize "UNDERWORLD.Chat.Footer"}}: <strong>{{retinueCount}}/{{maxRetinue}}</strong>
      </span>
    </div>

    <!-- Skład aktywnej Świty u boku Herszta -->
    <div class="active-retinue-bar">
      {{#if activeRetinue.length}}
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <span style="font-size: 0.8rem; color: #d8c2b0;">{{localize "UNDERWORLD.TacticsTab.AtYourSide"}}</span>
          {{#each activeRetinue}}
            <div class="retinue-chip" style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.12); padding: 2px 6px; border-radius: 4px; border: 1px solid #8e735b; font-size: 0.82rem;">
              <img src="{{this.img}}" style="width: 20px; height: 20px; border-radius: 2px; object-fit: cover;" />
              <strong>{{this.name}}</strong>
              {{{underworldRoleBadge this.role}}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <div style="background: rgba(183, 28, 28, 0.25); border: 1px solid #e57373; border-radius: 4px; padding: 6px 8px; font-size: 0.82rem; color: #ffcdd2;">
          <i class="fas fa-exclamation-triangle"></i> {{{localize "UNDERWORLD.TacticsTab.NoRetinue"}}}
        </div>
      {{/if}}
    </div>

    <p class="notes" style="margin-top: 0; margin-bottom: 0;">
      {{{localize "UNDERWORLD.TacticsTab.HowTo"}}}
    </p>
  </div>

  <div class="tactics-filter-empty" role="status" hidden>
    <i class="fas fa-user-slash"></i> {{localize "UNDERWORLD.TacticsTab.FilterEmpty"}}
  </div>

  <!-- ═══════ SEKCJA 1: OFENSYWNE I PRZEŁAMUJĄCE ═══════ -->
  <div class="tactic-group">
    <h4 class="tactic-group-title"><i class="fas fa-skull-crossbones"></i> {{localize "UNDERWORLD.TacticsTab.Offensive"}}</h4>
    <div class="tactic-cards-grid">

      <!-- Zajście z Flanki (Cień) -->
      <div data-order-id="flank" class="tactic-card {{#if tacticalOrders.flank.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.flank.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-shoe-prints"></i> {{tacticalOrders.flank.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.flank.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.flank.effect}}
        </div>
        {{#if tacticalOrders.flank.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.flank.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.flank.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="flank">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.flank.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Salwa z Ukrycia (Cień / Strzelec) -->
      <div data-order-id="volley" class="tactic-card {{#if tacticalOrders.volley.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.volley.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-crosshairs"></i> {{tacticalOrders.volley.name}}</strong>
          <span class="tactic-cost advantage-high"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost2"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.volley.desc}}</p>
        <div class="tactic-effect-summary">
          <strong>{{localize "UNDERWORLD.TacticsTab.Effect"}}:</strong> {{tacticalOrders.volley.effect}}
        </div>
        {{#if tacticalOrders.volley.isUnlocked}}
          <div class="tactic-executor-bar">
            <i class="fas fa-check-circle color-green"></i> {{localize "UNDERWORLD.TacticsTab.Executes"}}: <strong>{{tacticalOrders.volley.executor.name}}</strong> ({{{underworldRoleBadge tacticalOrders.volley.executor.role}}})
          </div>
          <button type="button" class="btn-order-tactic" data-action="order-tactic" data-order="volley">
            <i class="fas fa-bullhorn"></i> {{localize "UNDERWORLD.TacticsTab.Issue"}}
          </button>
        {{else}}
          <div class="tactic-locked-bar">
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Requires"}}: <strong>{{tacticalOrders.volley.reqRoleNames}}</strong>
          </div>
          <button type="button" class="btn-order-tactic btn-disabled" disabled>
            <i class="fas fa-lock"></i> {{localize "UNDERWORLD.TacticsTab.Locked"}}
          </button>
        {{/if}}
      </div>

      <!-- Cios w Nerkę (Cień) -->
      <div data-order-id="kidneystrike" class="tactic-card {{#if tacticalOrders.kidneystrike.executor}}tactic-has-retinue{{/if}} {{#if tacticalOrders.kidneystrike.isUnlocked}}tactic-unlocked{{else}}tactic-locked{{/if}}">
        <div class="tactic-card-header">
          <strong><i class="fas fa-tint"></i> {{tacticalOrders.kidneystrike.name}}</strong>
          <span class="tactic-cost advantage"><i class="fas fa-bolt"></i> {{localize "UNDERWORLD.TacticsTab.Cost1"}}</span>
        </div>
        <p class="tactic-desc">{{tacticalOrders.kidneystrike.desc}}</p>
        <div class="tactic-effect-summary">
