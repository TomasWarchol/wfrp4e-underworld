<div class="info-tab-container flexcol">
  <!-- SIATKA KART (2 KOLUMNY) -->
  <div class="info-grid">
    <!-- LEWA KOLUMNA: Profil, Teren, Rozgłos i Frakcje -->
    <div class="info-column flexcol">
      <!-- KARTA 1: PROFIL I BAZA -->
      <div class="info-card">
        <div class="card-title-row">
          <h4 class="card-title"><i class="fas fa-theater-masks"></i> {{underworldT "InfoTab.Profile"}}</h4>
        </div>
        
        <div class="info-field">
          <label><i class="fas fa-users-cog"></i> {{underworldT "InfoTab.Type"}}</label>
          <select name="type" {{#unless @root.isGM}}disabled title="{{underworldT 'InfoTab.TypeGMOnly'}}"{{/unless}}>
            {{#bajerySelect gang.type}}
            <option value="underworld">{{underworldT "InfoTab.Types.underworld"}}</option>
            <option value="mercenaries">{{underworldT "InfoTab.Types.mercenaries"}}</option>
            <option value="outlaws">{{underworldT "InfoTab.Types.outlaws"}}</option>
            <option value="smugglers">{{underworldT "InfoTab.Types.smugglers"}}</option>
            <option value="investigators">{{underworldT "InfoTab.Types.investigators"}}</option>
            <option value="cult">{{underworldT "InfoTab.Types.cult"}}</option>
            {{/bajerySelect}}
          </select>
        </div>

        <div class="info-field">
          <label><i class="fas fa-warehouse"></i> {{underworldT "InfoTab.Hideout"}}</label>
          <input type="text" name="hideout" value="{{gang.hideout}}" placeholder="{{underworldT 'InfoTab.HideoutPlaceholder'}}"/>
        </div>

        <div class="info-field">
          <label><i class="fas fa-map-marked-alt"></i> {{underworldT "InfoTab.Territory"}}</label>
          <input type="text" name="territory" value="{{gang.territory}}" placeholder="{{underworldT 'InfoTab.TerritoryPlaceholder'}}"/>
        </div>
      </div>

      <!-- KARTA 2: CZUJNOŚĆ PRAWA I ROZGŁOS (TYLKO MG EDYTUJE) -->
      <div class="info-card">
        <div class="card-title-row">
          <h4 class="card-title"><i class="fas fa-gavel"></i> {{underworldT "InfoTab.LawTitle"}}</h4>
          {{#if isGM}}
            <span class="badge-gm-only" title="{{underworldT 'InfoTab.GMOnlyHeat'}}"><i class="fas fa-crown"></i> {{underworldT "InfoTab.GMOnly"}}</span>
          {{else}}
            <span class="badge-locked" title="{{underworldT 'InfoTab.SetByGMHint'}}"><i class="fas fa-lock"></i> {{underworldT "InfoTab.SetByGM"}}</span>
          {{/if}}
        </div>
        
        <div class="info-field">
          <label><i class="fas fa-balance-scale"></i> {{underworldT "InfoTab.HeatLevel"}}</label>
          {{#if isGM}}
            <select name="notoriety" class="gm-editable-select">
              {{#bajerySelect gang.notoriety}}
              <option value="0">0 – {{underworldT "Notoriety.0.Name"}} ({{underworldT "InfoTab.HeatShort.0"}})</option>
              <option value="1">1 – {{underworldT "Notoriety.1.Name"}} ({{underworldT "InfoTab.HeatShort.1"}})</option>
              <option value="2">2 – {{underworldT "Notoriety.2.Name"}} ({{underworldT "InfoTab.HeatShort.2"}})</option>
              <option value="3">3 – {{underworldT "Notoriety.3.Name"}} ({{underworldT "InfoTab.HeatShort.3"}})</option>
              <option value="4">4 – {{underworldT "Notoriety.4.Name"}} ({{underworldT "InfoTab.HeatShort.4"}})</option>
              <option value="5">5 – {{underworldT "Notoriety.5.Name"}} ({{underworldT "InfoTab.HeatShort.5"}})</option>
              {{/bajerySelect}}
            </select>
          {{else}}
            <div class="readonly-display-field">
              {{{underworldNotorietyBadge gang.notoriety}}}
            </div>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-scroll"></i> {{underworldT "InfoTab.Bounty"}}</label>
          {{#if isGM}}
            <input type="text" name="bounty" value="{{gang.bounty}}" placeholder="{{underworldT 'InfoTab.BountyPlaceholder'}}"/>
          {{else}}
            <input type="text" value="{{gang.bounty}}" disabled class="input-readonly" title="{{underworldT 'InfoTab.BountyHint'}}"/>
          {{/if}}
        </div>
      </div>

      <!-- KARTA 3: FRAKCJE: SOJUSZNICY I WROGOWIE -->
      <div class="info-card">
        <div class="card-title-row">
          <h4 class="card-title"><i class="fas fa-people-arrows"></i> {{underworldT "InfoTab.Factions"}}</h4>
        </div>
        
        <div class="info-field">
          <label><i class="fas fa-hand-holding-heart"></i> {{underworldT "InfoTab.Allies"}}</label>
          <textarea name="allies" rows="2" placeholder="{{underworldT 'InfoTab.AlliesPlaceholder'}}">{{gang.allies}}</textarea>
        </div>

        <div class="info-field">
          <label><i class="fas fa-skull"></i> {{underworldT "InfoTab.Rivals"}}</label>
          <textarea name="rivals" rows="2" placeholder="{{underworldT 'InfoTab.RivalsPlaceholder'}}">{{gang.rivals}}</textarea>
        </div>
      </div>
    </div>

    <!-- PRAWA KOLUMNA: Patron, Zobowiązania, Kodeks i Kronika -->
    <div class="info-column flexcol">
      <!-- KARTA 4: PRZEŁOŻONY / PATRON (TYLKO MG EDYTUJE) -->
      <div class="info-card patron-card">
        <div class="card-title-row">
          <h4 class="card-title"><i class="fas fa-user-secret"></i> {{underworldT "InfoTab.Patron"}}</h4>
          {{#if isGM}}
            <span class="badge-gm-only" title="{{underworldT 'InfoTab.GMOnlyPatron'}}"><i class="fas fa-crown"></i> {{underworldT "InfoTab.GMOnly"}}</span>
          {{else}}
            <span class="badge-locked" title="{{underworldT 'InfoTab.PatronSetByGM'}}"><i class="fas fa-lock"></i> {{underworldT "InfoTab.SetByGM"}}</span>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-user-tie"></i> {{underworldT "InfoTab.PatronName"}}</label>
          {{#if isGM}}
            <input type="text" name="patron.name" value="{{gang.patron.name}}" placeholder="{{underworldT 'InfoTab.PatronNamePlaceholder'}}"/>
          {{else}}
            <input type="text" value="{{gang.patron.name}}" disabled class="input-readonly"/>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-id-badge"></i> {{underworldT "InfoTab.PatronTitle"}}</label>
          {{#if isGM}}
            <input type="text" name="patron.title" value="{{gang.patron.title}}" placeholder="{{underworldT 'InfoTab.PatronTitlePlaceholder'}}"/>
          {{else}}
            <input type="text" value="{{gang.patron.title}}" disabled class="input-readonly"/>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-handshake"></i> {{underworldT "InfoTab.PatronRelation"}}</label>
          {{#if isGM}}
            <select name="patron.relation" class="gm-editable-select">
              {{#bajerySelect gang.patron.relation}}
              <option value="favorite">🌟 {{underworldT "InfoTab.RelationShort.favorite"}}</option>
              <option value="trusted">🤝 {{underworldT "InfoTab.RelationShort.trusted"}}</option>
              <option value="neutral">⚖️ {{underworldT "InfoTab.RelationShort.neutral"}}</option>
              <option value="strained">⚠️ {{underworldT "InfoTab.RelationShort.strained"}}</option>
              <option value="hostile">☠️ {{underworldT "InfoTab.RelationShort.hostile"}}</option>
              {{/bajerySelect}}
            </select>
          {{else}}
            <div class="readonly-display-field">
              {{{underworldRelationBadge gang.patron.relation}}}
            </div>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-percentage"></i> {{underworldT "InfoTab.PatronCut"}}</label>
          {{#if isGM}}
            <input type="text" name="patron.cut" value="{{gang.patron.cut}}" placeholder="{{underworldT 'InfoTab.PatronCutPlaceholder'}}"/>
          {{else}}
            <input type="text" value="{{gang.patron.cut}}" disabled class="input-readonly"/>
          {{/if}}
        </div>

        <div class="info-field">
          <label><i class="fas fa-envelope-open-text"></i> {{underworldT "InfoTab.PatronNotes"}}</label>
          {{#if isGM}}
            <textarea name="patron.notes" rows="3" placeholder="{{underworldT 'InfoTab.PatronNotesPlaceholder'}}">{{gang.patron.notes}}</textarea>
          {{else}}
            <textarea disabled class="input-readonly" rows="3">{{gang.patron.notes}}</textarea>
          {{/if}}
        </div>
      </div>

      <!-- KARTA 5: KODEKS I KRONIKA -->
      <div class="info-card">
        <div class="card-title-row">
          <h4 class="card-title"><i class="fas fa-book-open"></i> {{underworldT "InfoTab.CodeTitle"}}</h4>
        </div>
        
        <div class="info-field">
          <label><i class="fas fa-shield-alt"></i> {{underworldT "InfoTab.Code"}}</label>
          <textarea name="code" rows="2" placeholder="{{underworldT 'InfoTab.CodePlaceholder'}}">{{gang.code}}</textarea>
        </div>

        <div class="info-field">
          <label><i class="fas fa-feather-alt"></i> {{underworldT "InfoTab.Notes"}}</label>
          <textarea name="notes" rows="3" placeholder="{{underworldT 'InfoTab.NotesPlaceholder'}}">{{gang.notes}}</textarea>
        </div>
      </div>
    </div>
  </div>
</div>
