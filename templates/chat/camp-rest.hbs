<div class="wfrp4e-underworld chat-card camp-rest-card" data-company-type="{{companyType}}">
  <div class="card-header camp-card-header">
    {{#if skyline}}<span class="uw-ledger-only camp-card-skyline" data-uw-glyph="{{skyline}}"></span>{{/if}}
    <h3 class="camp-card-title"><i class="fas fa-campground"></i> {{title}}</h3>
    {{#if terrainName}}<div class="uw-card-sub">{{underworldT "Camp.Terrain"}}: {{terrainName}}</div>{{/if}}
  </div>

  <div class="rest-details">
    <p><strong>{{underworldT "Camp.Lodging"}}:</strong> {{shelterName}}</p>
    <p><strong>{{underworldT "Camp.Sentries"}}:</strong> {{watchmenNames}}</p>
    <p><strong>{{underworldT "Camp.Meal"}}:</strong> {{foodSummary}}</p>
    <p><strong>{{underworldT "Camp.Recovery"}}:</strong> {{healedList}}</p>
    <p><strong>{{underworldT "Camp.State"}}:</strong> {{underworldT "Camp.StateLine" morale=morale heat=notoriety supplies=supplies}}</p>
    {{#if racket}}<p><strong><i class="fas fa-store"></i> {{underworldT "Badges.racket"}}:</strong> {{{racket.text}}}</p>{{/if}}
  </div>

  {{#if missions.length}}
  <div class="camp-block camp-block-jobs">
    <strong><i class="fas fa-tasks"></i> {{underworldT "Camp.WeekJobs"}}:</strong>
    <ul>
      {{#each missions}}
      <li>
        <strong>{{this.title}}</strong> – {{this.npcName}}:
        {{#if this.isSuccess}}<span class="camp-ok">{{underworldT "Chat.SuccessLower"}}</span>{{else}}<span class="camp-bad">{{underworldT "Chat.FailureLower"}}</span>{{/if}}
        {{#if this.roll}}<span class="camp-muted">({{this.roll}} vs {{this.target}}, SL {{this.sl}})</span>{{/if}}
        <div>{{{this.notes}}}</div>
        {{#if this.rollSummary}}<div class="camp-muted camp-small"><i class="fas fa-dice"></i> {{this.rollSummary}}</div>{{/if}}
        {{#if this.rumor}}<div class="camp-quote">„{{this.rumor}}”</div>{{/if}}
        {{#each this.gains}}<div class="camp-ok"><i class="fas fa-chess-knight"></i> {{{this}}}</div>{{/each}}
        {{#each this.consequences}}<div class="camp-bad"><i class="fas fa-exclamation-triangle"></i> {{{this}}}</div>{{/each}}
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{#if raid}}
  <div class="camp-block camp-block-raid">
    <strong><i class="fas fa-bullhorn"></i> {{raid.title}}</strong>
    <ul>{{#each raid.lines}}<li>{{{this}}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  {{#if desertion}}
  <div class="camp-block camp-block-desertion">
    <strong><i class="fas fa-person-running"></i> {{underworldT "Camp.Desertion"}}</strong>
    <p>{{{desertion.text}}}</p>
  </div>
  {{/if}}

  {{#if event}}
  <div class="camp-block camp-block-event">
    <strong>{{underworldT "Camp.NightEvent"}}: {{event.title}}</strong>
    <p class="camp-event-text">{{event.text}}</p>
    {{#if event.roleNote}}<p class="camp-small"><i class="fas fa-id-badge"></i> {{{event.roleNote}}}</p>{{/if}}
    {{#if event.followUp}}<p class="camp-small camp-muted"><i class="fas fa-link"></i> {{underworldT "CampEvent.FollowUp"}}</p>{{/if}}
    {{#if event.next}}<p class="camp-small camp-muted"><i class="fas fa-link"></i> {{underworldT "CampEvent.HookSet"}}</p>{{/if}}
  </div>
  {{/if}}

  {{#if flawEffects.length}}
  <div class="camp-block camp-block-flaws">
    <strong><i class="fas fa-exclamation-triangle"></i> {{underworldT "Camp.FlawsShowed"}}</strong>
    <ul>{{#each flawEffects}}<li>{{{this}}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  <div class="card-footer camp-card-footer">{{underworldT "Camp.EndOfDay"}} • WFRP 4e</div>
</div>
