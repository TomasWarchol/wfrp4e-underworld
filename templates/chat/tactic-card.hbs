<div class="wfrp4e-underworld chat-card tactic-card-chat {{#if orderFailed}}is-failure{{else}}is-success{{/if}}" data-company-type="{{companyType}}">
  <div class="tactic-chat-header">
    <img src="{{actor.img}}" class="tactic-chat-avatar" alt="{{actor.name}}" />
    <div class="tactic-chat-title-col">
      <div class="tactic-chat-eyebrow">{{underworldT "TacticCard.Gives" name=actor.name}}</div>
      <h3 class="tactic-chat-title">{{#if orderGlyph}}<span class="uw-ledger-only uw-card-glyph" data-uw-glyph="{{orderGlyph}}"></span>{{/if}}{{order.name}}</h3>
    </div>
  </div>

  <div class="tactic-desc"><p>„{{order.desc}}"</p></div>

  {{#if executor}}
    <div class="tactic-executor-card">
      <img src="{{executor.img}}" alt="" />
      <div class="tactic-executor-text">
        <div class="tactic-executor-label">{{underworldT "TacticCard.Executor"}}</div>
        <div class="tactic-executor-name"><span>{{executor.name}}</span> {{{underworldRoleBadge executor.role}}}</div>
      </div>
    </div>
  {{/if}}

  {{#if rollResult}}
    <div class="tactic-roll-box {{#if rollResult.isSuccess}}is-success{{else}}is-failure{{/if}}">
      <div class="tactic-roll-head">
        <span><i class="fas {{#if rollResult.isSuccess}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i> {{underworldT "Orders.Dialog.Leadership"}}</span>
        <span>{{#if rollResult.isSuccess}}{{underworldT "TacticCard.Success"}} ({{rollResult.sl}} SL){{else}}{{underworldT "TacticCard.Failure"}} ({{rollResult.sl}} SL){{/if}}</span>
      </div>
      <div class="tactic-roll-line">
        {{underworldT "TacticCard.Roll"}}: <strong>{{rollResult.roll}}</strong> vs {{underworldT "TacticCard.Target"}}: <strong>{{rollResult.target}}</strong> ({{rollResult.skillName}})
      </div>
      {{#if (bajeryGt rollResult.advantageGained 0)}}
        <div class="tactic-advantage"><i class="fas fa-bolt"></i> {{underworldT "TacticCard.AdvantageGained" value=rollResult.advantageGained}}</div>
      {{/if}}
    </div>
  {{else if (bajeryEq method "advantage")}}
    <div class="tactic-advantage-spent-box"><i class="fas fa-bolt"></i> {{underworldT "TacticCard.AdvantageSpent" value=order.advantageCost}}</div>
  {{/if}}

  {{#if orderFailed}}
  <div class="tactic-effect is-failure"><i class="fas fa-times-circle"></i> {{{underworldT "TacticCard.NotHeard"}}}</div>
  {{else}}
  <div class="tactic-effect">
    <h4><i class="fas fa-gavel"></i> {{underworldT "TacticCard.Effect"}}</h4>
    <p>{{{order.effect}}}</p>
  </div>
  {{/if}}
  {{#if automationLines.length}}
  <div class="tactic-automation">
    <strong><i class="fas fa-crosshairs"></i> {{underworldT "TacticCard.TargetEffects"}}</strong>
    <ul>{{#each automationLines}}<li>{{{this}}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  {{#if inCombat}}
  <div class="tactic-uses-action"><i class="fas fa-hourglass-half"></i> {{underworldT "TacticCard.UsesAction"}}</div>
  {{/if}}
</div>
