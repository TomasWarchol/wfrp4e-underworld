<div class="wfrp4e-underworld chat-card recruit-proposals-card" data-actor-id="{{actorId}}">
  <div class="card-header" style="border-bottom: 2px solid #5a3d28; padding-bottom: 6px; margin-bottom: 8px;">
    <h3 style="margin: 0; color: #4a2810; font-size: 1.15rem;">
      <i class="fas fa-user-plus" style="color: #2e7d32;"></i> {{localize "UNDERWORLD.RecruitCard.Title"}}
    </h3>
    <div style="font-size: 0.8rem; color: #665544; margin-top: 2px;">
      {{localize "UNDERWORLD.RecruitCard.Intro"}}
    </div>
  </div>

  {{#if gmNote}}
  <div style="background: rgba(120, 80, 40, 0.08); border-left: 3px solid #7c5e44; padding: 6px 8px; margin-bottom: 10px; border-radius: 2px; font-size: 0.84rem; font-style: italic; color: #3b2a1a;">
    <i class="fas fa-comment"></i> {{gmNote}}
  </div>
  {{/if}}

  {{#if chosen}}
  <div class="recruit-chosen-banner" style="background: rgba(46, 82, 35, 0.15); border: 2px solid #3e6d2f; border-radius: 4px; padding: 8px; margin-bottom: 10px; text-align: center;">
    <strong style="color: #173b0f; font-size: 0.95rem;">
      <i class="fas fa-check-circle"></i> {{localize "UNDERWORLD.RecruitCard.Recruited"}}: {{chosen}}
    </strong>
    <div style="font-size: 0.8rem; color: #3b2a1a; margin-top: 2px;">
      {{localize "UNDERWORLD.RecruitCard.DecidedBy"}}: <strong>{{chosenBy}}</strong>. {{localize "UNDERWORLD.RecruitCard.Joined"}}
    </div>
  </div>
  {{/if}}

  <div class="recruit-candidates-list" style="display: flex; flex-direction: column; gap: 8px;">
    {{#each candidates}}
    <div class="recruit-candidate-card {{#if (bajeryEq ../chosen this.name)}}is-chosen{{/if}}" style="border: 2px solid {{#if (bajeryEq ../chosen this.name)}}#3e6d2f{{else}}#5a3d28{{/if}}; background: {{#if (bajeryEq ../chosen this.name)}}rgba(46, 82, 35, 0.12){{else}}rgba(255,255,255,0.75){{/if}}; border-radius: 4px; padding: 8px; display: flex; flex-direction: column; gap: 6px; box-shadow: inset 0 0 6px rgba(90,60,30,0.15);">
      <div style="display: flex; gap: 10px; align-items: center;">
        <img src="{{this.img}}" style="width: 44px; height: 44px; object-fit: cover; border-radius: 3px; border: 2px solid #5a3d28;" />
        <div style="flex: 1;">
          <div style="font-weight: bold; font-size: 1.05rem; color: #2b1d11;">{{this.name}}</div>
          <div style="margin-top: 2px;">
            <span class="role-badge {{this.roleBadgeClass}}" style="font-size: 0.8rem;">
              <i class="{{this.roleIcon}}"></i> {{this.roleName}}
            </span>
          </div>
        </div>
      </div>

      <div style="font-size: 0.82rem; display: flex; flex-direction: column; gap: 3px; background: rgba(0,0,0,0.04); padding: 5px 8px; border-radius: 3px; border-left: 3px solid #7c5838;">
        <div style="color: #173b0f;">
          <i class="fas fa-plus-circle"></i> <strong>{{localize "UNDERWORLD.RecruitCard.Strength"}}:</strong> {{this.strengthName}} <span style="color: #554433;">({{this.strengthDesc}})</span>
        </div>
        <div style="color: #6b1414;">
          <i class="fas fa-minus-circle"></i> <strong>{{localize "UNDERWORLD.RecruitCard.Flaw"}}:</strong> {{this.flawName}} <span style="color: #554433;">({{this.flawDesc}})</span>
        </div>
      </div>

      {{#unless ../chosen}}
      <button type="button" class="btn-recruit-candidate btn-actor-action" data-candidate-id="{{this.id}}" data-actor-id="{{../actorId}}" style="margin-top: 4px; padding: 6px 10px; font-weight: bold; cursor: pointer; text-align: center;">
        <i class="fas fa-handshake"></i> {{localize "UNDERWORLD.RecruitCard.Recruit" name=this.name}}
      </button>
      {{/unless}}
    </div>
    {{/each}}
  </div>

  <div class="card-footer" style="border-top: 1px dashed #8e735b; padding-top: 4px; font-size: 0.8rem; color: #5e584f; text-align: right; margin-top: 8px;">
    {{localize "UNDERWORLD.RecruitCard.Footer"}} • WFRP 4e
  </div>
</div>