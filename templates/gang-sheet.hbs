<div class="underworld-sheet-form">
  {{#if ledger}}
  {{> "modules/wfrp4e-underworld/templates/parts/ledger-header.hbs"}}
  <div class="uw-l-main">
  {{> "modules/wfrp4e-underworld/templates/parts/ledger-nav.hbs"}}
  {{else}}
  <!-- GŁÓWNY BANER WOJENNY SZAJKI (WIDOCZNY WE WSZYSTKICH ZAKŁADKACH) -->
  <header class="sheet-header underworld-master-header">
    <div class="master-banner-inner">
      <!-- Lewa: Herszt -->
      <div class="boss-frame-wrapper">
        <img class="boss-master-avatar" src="{{actor.img}}" alt="{{actor.name}}" title="{{underworldT 'Sheet.LeaderTitle' name=actor.name}}"/>
        <div class="boss-crown-badge" title="{{underworldT 'Sheet.ChiefTitle'}}"><i class="fas fa-crown"></i> {{underworldT "Sheet.Chief"}}</div>
      </div>

      <!-- Środek: Tożsamość Szajki -->
      <div class="gang-identity-col">
        <div class="gang-eyebrow"><i class="fas fa-shield-alt"></i> {{underworldT "Sheet.Eyebrow"}}</div>
        <div class="gang-name-row">
          <input type="text" name="name" value="{{gang.name}}" class="master-gang-name" placeholder="{{underworldT 'Sheet.NamePlaceholder'}}" title="{{underworldT 'Sheet.NameTitle'}}"/>
        </div>
        <div class="gang-motto-row">
          <i class="fas fa-quote-left text-muted"></i>
          <input type="text" name="motto" value="{{gang.motto}}" class="master-gang-motto" placeholder="{{underworldT 'Sheet.MottoPlaceholder'}}" title="{{underworldT 'Sheet.MottoTitle'}}"/>
          <i class="fas fa-quote-right text-muted"></i>
        </div>
        <div class="master-submeta">
          <span class="submeta-item"><i class="fas fa-user-shield"></i> {{underworldT "Sheet.Leader"}}: <strong>{{actor.name}}</strong></span>
          <span class="submeta-divider">•</span>
          <span class="submeta-item">{{{underworldNotorietyBadge gang.notoriety}}}</span>
          <span class="submeta-divider">•</span>
          <span class="submeta-item">{{{underworldRelationBadge gang.patron.relation}}}</span>
          <span class="submeta-divider">•</span>
          <span class="submeta-item"><span class="uw-terrain-badge"><i class="{{terrain.icon}}"></i> {{terrain.name}}</span></span>
        </div>
      </div>

      <!-- Prawa: Szybki Pasek Kluczowych Zasobów -->
      <div class="master-quick-stats">
        <div class="stat-pill morale-pill" title="{{underworldT 'Sheet.MoraleTitle' value=gang.morale}}">
          <i class="fas fa-heart text-danger"></i>
          <span class="stat-label">{{underworldT "Sheet.Morale"}}:</span>
          <strong>{{gang.morale}}</strong><small>/10</small>
        </div>

        <div class="stat-pill supplies-pill" title="{{underworldT 'Sheet.SuppliesTitle' value=gang.supplies}}">
          <i class="fas fa-bread-slice text-gold"></i>
          <span class="stat-label">{{underworldT "Sheet.Supplies"}}:</span>
          <strong>{{gang.supplies}}</strong><small>/30</small>
        </div>

        <div class="stat-pill treasury-pill" title="{{underworldT 'Upgrade.Stash'}}">
          <i class="fas fa-coins text-gold"></i>
          <span class="treasury-short-val"><strong>{{{underworldFormatCoins gang.treasury}}}</strong></span>
        </div>
      </div>
    </div>
  </header>

  <!-- NAWIGACJA ZAKŁADKOWA -->
  <nav class="sheet-tabs tabs underworld-tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="info"><i class="fas fa-scroll"></i> {{underworldT "Tabs.Info"}}</a>
    {{#if tabsVisible.dashboard}}<a class="item" data-action="tab" data-group="primary" data-tab="dashboard"><i class="fas fa-campground"></i> {{underworldT "Tabs.Camp"}}</a>{{/if}}
    {{#if tabsVisible.roster}}<a class="item" data-action="tab" data-group="primary" data-tab="roster"><i class="fas fa-users"></i> {{underworldT "Tabs.Roster"}} <span class="tab-counter">({{gang.roster.length}})</span></a>{{/if}}
    {{#if tabsVisible.tasks}}<a class="item" data-action="tab" data-group="primary" data-tab="tasks"><i class="fas fa-tasks"></i> {{underworldT "Tabs.Tasks"}} <span class="tab-counter">({{availableOutlaws.length}})</span></a>{{/if}}
    {{#if tabsVisible.loot}}<a class="item" data-action="tab" data-group="primary" data-tab="loot"><i class="fas fa-sack-xmark"></i> {{underworldT "Tabs.Loot"}} <span class="tab-counter">({{lootCount}})</span></a>{{/if}}
    {{#if tabsVisible.tactics}}<a class="item" data-action="tab" data-group="primary" data-tab="tactics"><i class="fas fa-chess-knight"></i> {{underworldT "Tabs.Tactics"}} <span class="tab-counter">({{retinueCount}}/{{maxRetinue}})</span></a>{{/if}}
    {{#if isGM}}<a class="item" data-action="tab" data-group="primary" data-tab="gm"><i class="fas fa-crown"></i> {{underworldT "Tabs.GM"}}</a>{{/if}}
  </nav>
  {{/if}}

  <!-- ZAWARTOŚĆ ZAKŁADEK -->
  <section class="sheet-body underworld-sheet-body">
    <div class="tab" data-group="primary" data-tab="info">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-chronicle.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/info.hbs"}}{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="dashboard">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-camp.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/dashboard.hbs"}}{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="roster">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-roster.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/roster.hbs"}}{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="tasks">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-plan.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/tasks.hbs"}}{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="loot">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-chest.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/loot.hbs"}}{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="tactics">
      {{#if ledger}}{{> "modules/wfrp4e-underworld/templates/parts/ledger-orders.hbs"}}{{else}}{{> "modules/wfrp4e-underworld/templates/parts/tactics.hbs"}}{{/if}}
    </div>

    {{#if isGM}}
    <div class="tab" data-group="primary" data-tab="gm">
      {{> "modules/wfrp4e-underworld/templates/parts/gm.hbs"}}
    </div>
    {{/if}}
  </section>
  {{#if ledger}}</div>{{/if}}
</div>
